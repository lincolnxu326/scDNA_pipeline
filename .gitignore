# Snakemake runtime state
.snakemake/

# Conda caches and environments
.conda/
.renv/

# renv local library cache
renv/library/

# Generated reports and graphs
report.html
rulegraph*.dot
rulegraph*.pdf
Rplots.pdf

# Pipeline and scheduler logs
logs/

# Generated pipeline outputs
results/
resources/

# Human QC decisions now live per-plate at <PLATE_DIR>/qc_decisions.csv (in the data
# directory, outside this repo). config/ keeps only the template + schema docs.
# Ignore a stray copy if one is ever dropped here by mistake.
config/qc_decisions.csv

# ad hoc checks: keep only source R scripts tracked here
ad_hoc_checks/*
!ad_hoc_checks/*.R

# Python bytecode (plate384_layout.py is imported at Snakefile parse time and by the
# reporting scripts, so several interpreters drop caches next to it)
__pycache__/
*.pyc

# UI design material handed over by the design agent: the prototype, the spec, the
# handoff CSS/JS, screenshots and scratch assets. Kept on disk as the reference for
# how the report is meant to look, but not part of the pipeline — the code the
# pipeline actually runs is workflow/scripts/reporting/assets/qc_review.{css,js},
# which IS tracked.
design/

# OS/editor noise
.DS_Store
Thumbs.db
AGENT_CONTEXT.md
